<?php if ($paginator->totalOfPages() > 1): ?>
    <nav aria-label="Paginação">
        <ul class="pagination">
            <?php if ($paginator->hasPreviousPage()): ?>
                <li class="page-item">
                    <a class="page-link" href="<?= htmlspecialchars(route($paginator->getRouteName(), ['page' => $paginator->previousPage()]), ENT_QUOTES, 'UTF-8') ?>">Anterior</a>
                </li>
            <?php endif; ?>

            <?php for ($page = 1; $page <= $paginator->totalOfPages(); $page++): ?>
                <li class="page-item <?= $paginator->isPage($page) ? 'active' : '' ?>">
                    <a class="page-link" href="<?= htmlspecialchars(route($paginator->getRouteName(), ['page' => $page]), ENT_QUOTES, 'UTF-8') ?>" <?= $paginator->isPage($page) ? 'aria-current="page"' : '' ?>>
                        <?= $page ?>
                    </a>
                </li>
            <?php endfor; ?>

            <?php if ($paginator->hasNextPage()): ?>
                <li class="page-item">
                    <a class="page-link" href="<?= htmlspecialchars(route($paginator->getRouteName(), ['page' => $paginator->nextPage()]), ENT_QUOTES, 'UTF-8') ?>">Próxima</a>
                </li>
            <?php endif; ?>
        </ul>
    </nav>
<?php endif; ?>
