
<?php if (empty($photos)): ?>
    <p>Este pallet ainda não tem fotos.</p>
<?php else: ?>
    <div class="gallery">
        <?php foreach ($photos as $photo): ?>
            <figure>
               <a href="<?= htmlspecialchars($photo->url, ENT_QUOTES, 'UTF-8') ?>" target="_blank" rel="noopener"> 
                    <img
                        src="<?= htmlspecialchars($photo->url, ENT_QUOTES, 'UTF-8') ?>"
                        alt="<?= htmlspecialchars($photo->original_name, ENT_QUOTES, 'UTF-8') ?>"
                        loading="lazy"
                    >
                </a>
                <figcaption>
                    <?= htmlspecialchars($photo->original_name, ENT_QUOTES, 'UTF-8') ?>
                </figcaption>
            </figure>
            <form action="<?= route('pallets.gallery.remove', ['id' => $pallet->id, 'photo_id' => $photo->id]) ?>" method="POST">
                <input type="hidden" name="_method" value="DELETE"> 
                <button class="btn-exclude" type="submit">Excluir</button>
            </form> 
        <?php endforeach; ?>
    </div>
<?php endif; ?>

<style>
    .gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 16px;
    }

    .gallery img {
        width: 100%;
        height: 180px;
        object-fit: cover;
    }
    .btn-exclude {
        background-color:#DC3545 ;
        color: white;
        display:block;                             
    }
</style>