<?php
$movements = $movements ?? [];
$typeLabels = [
    'inbound' => 'Entrada',
    'outbound' => 'Saída',
    'inventory' => 'Inventário',
];
$escape = static fn(mixed $value): string => htmlspecialchars(
    (string) ($value ?? ''),
    ENT_QUOTES,
    'UTF-8'
);
?>

<div class="p-4">
    <?php if (empty($movements)): ?>
        <div class="alert alert-info" role="status">
            Ainda não há movimentações registradas.
        </div>
    <?php else: ?>
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Código</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Usuário</th>
                        <th scope="col">Observação</th>
                        <th scope="col">Pallets e quantidades</th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($movements as $movement): ?>
                        <?php $palletMovements = $movement->palletMovements; ?>
                    <tr>
                        <td>#<?= $escape($movement->id) ?></td>
                        <td><?= $escape($typeLabels[$movement->type] ?? $movement->type) ?></td>
                        <td><?= $escape($movement->user?->name ?? 'Usuário indisponível') ?></td>
                        <td><?= $escape($movement->observation ?: '—') ?></td>

                        <td>
                            <?php if (empty($palletMovements)): ?>
                                <span class="text-muted">Nenhum pallet associado</span>
                            <?php else: ?>
                                <ul class="mb-0 ps-3">
                                    <?php foreach ($palletMovements as $palletMovement): ?>
                                        <li>
                                            <?= $escape($palletMovement->pallet?->item ?? 'Pallet indisponível') ?>
                                            — quantidade: <?= $escape($palletMovement->quantity) ?>;
                                            antes: <?= $escape($palletMovement->quantity_before) ?>;
                                            depois: <?= $escape($palletMovement->quantity_after) ?>
                                        </li>
                                    <?php endforeach; ?>
                                </ul>
                            <?php endif; ?>
                        </td>

                        <td>
                            <?php if (!empty($palletMovements)): ?>
                                <?php foreach ($palletMovements as $palletMovement): ?>
                                    <form action="<?= route('movements.remove', ['id' => $palletMovement->id]) ?>" method="POST">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <button type="submit">Excluir <?= $palletMovement->pallet?->item ?? '' ?></button>
                                    </form>
                                <?php endforeach; ?>
                            <?php endif; ?>
                        </td>
                    </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        </div>
    <?php endif; ?>
</div>
