<?php
$pallets = $pallets ?? [];

$movementType = $movementType ?? 'inbound';
$allowedTypes = ['inbound', 'outbound', 'inventory'];

if (!in_array($movementType, $allowedTypes, true)) {
    $movementType = 'inbound';
}

$palletOptions = '<option value="">Selecione um pallet</option>';
foreach ($pallets as $pallet) {
    $label = htmlspecialchars(
        $pallet->item . ' (' . $pallet->width . ' x ' . $pallet->length . ')',
        ENT_QUOTES,
        'UTF-8'
    );
    $palletOptions .= '<option value="' . (int) $pallet->id . '">' . $label . '</option>';
}
?>

<div class="p-4">
    <form
        action="/movements"
        method="POST"
        class="col-12 col-md-8 col-lg-6"
        id="movement-form"
    >
        <div class="form-group mb-3">
            <label for="movement_type" class="form-label">Tipo de movimentação</label>
            <select id="movement_type" name="movement[type]" class="form-select" required>
                <option value="inbound" <?= $movementType === 'inbound' ? 'selected' : '' ?>>
                    Entrada
                </option>
                <option value="outbound" <?= $movementType === 'outbound' ? 'selected' : '' ?>>
                    Saída
                </option>
                <option value="inventory" <?= $movementType === 'inventory' ? 'selected' : '' ?>>
                    Inventário
                </option>
            </select>
        </div>

        <div class="form-group mb-3">
            <label for="movement_observation" class="form-label">Observação</label>
            <textarea
                id="movement_observation"
                name="movement[observation]"
                class="form-control"
                maxlength="500"
                rows="3"
                placeholder="Observação opcional"
            ></textarea>
        </div>

        <fieldset class="mb-3">
            <legend class="form-label">Pallets</legend>
            <p id="movement-help" class="form-text">
                Para entrada e saída, informe o pallet e a quantidade movimentada.
                No inventário, informe a quantidade física contada; você pode adicionar vários pallets.
            </p>

            <div id="pallet-movement-rows">
                <div class="pallet-movement-row border rounded p-3 mb-3">
                    <div class="form-group mb-3">
                        <label class="form-label pallet-label">Pallet</label>
                        <select
                            name="pallet_movements[0][pallet_id]"
                            class="form-select pallet-select"
                            required
                        >
                            <?= $palletOptions ?>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label quantity-label">Quantidade</label>
                        <input
                            type="number"
                            name="pallet_movements[0][quantity]"
                            class="form-control quantity-input"
                            min="1"
                            step="1"
                            required
                        >
                    </div>

                    <button
                        type="button"
                        class="btn btn-outline-danger btn-sm mt-3 remove-pallet-row"
                        hidden
                    >
                        Remover pallet da seleção
                    </button>
                </div>
            </div>

            <button type="button" class="btn btn-outline-primary" id="add-pallet-row" hidden>
                Adicionar pallet
            </button>
        </fieldset>

        <div class="d-grid">
            <button type="submit" class="btn btn-primary">Registrar movimentação</button>
        </div>
    </form>
</div>

<template id="pallet-movement-row-template">
    <div class="pallet-movement-row border rounded p-3 mb-3">
        <div class="form-group mb-3">
            <label class="form-label pallet-label">Pallet</label>
            <select
                name="pallet_movements[__INDEX__][pallet_id]"
                class="form-select pallet-select"
                required
            >
                <?= $palletOptions ?>
            </select>
        </div>

        <div class="form-group">
            <label class="form-label quantity-label">Quantidade</label>
            <input
                type="number"
                name="pallet_movements[__INDEX__][quantity]"
                class="form-control quantity-input"
                min="1"
                step="1"
                required
            >
        </div>

        <button
            type="button"
            class="btn btn-outline-danger btn-sm mt-3 remove-pallet-row"
        >
            Remover pallet da seleção
        </button>
    </div>
</template>

<script>
(() => {
    const typeSelect = document.getElementById('movement_type');
    const rowsContainer = document.getElementById('pallet-movement-rows');
    const rowTemplate = document.getElementById('pallet-movement-row-template');
    const addRowButton = document.getElementById('add-pallet-row');
    let nextIndex = 1;

    const updateFormForType = () => {
        const isInventory = typeSelect.value === 'inventory';
        const rows = [...rowsContainer.querySelectorAll('.pallet-movement-row')];

        addRowButton.hidden = !isInventory;

        rows.forEach((row, index) => {
            const isAdditionalRow = index > 0;
            const isDisabled = isAdditionalRow && !isInventory;

            row.hidden = isDisabled;
            row.querySelector('.pallet-select').disabled = isDisabled;
            row.querySelector('.quantity-input').disabled = isDisabled;
            row.querySelector('.remove-pallet-row').hidden =
                !isInventory || rows.length === 1;

            row.querySelector('.quantity-label').textContent =
                isInventory ? 'Quantidade física contada' : 'Quantidade';
            row.querySelector('.quantity-input').min = isInventory ? '0' : '1';
        });
    };

    typeSelect.addEventListener('change', updateFormForType);

    addRowButton.addEventListener('click', () => {
        const rowHtml = rowTemplate.innerHTML.replaceAll('__INDEX__', String(nextIndex++));
        rowsContainer.insertAdjacentHTML('beforeend', rowHtml);
        updateFormForType();
    });

    rowsContainer.addEventListener('click', (event) => {
        if (event.target.closest('.remove-pallet-row')) {
            event.target.closest('.pallet-movement-row').remove();
            updateFormForType();
        }
    });

    updateFormForType();
})();
</script>
